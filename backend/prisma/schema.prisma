generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  PARENT
  STAFF
  CLASS_ADMIN
  TEACHER
  ADMIN
  SUPER_USER
}

enum TreasuryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChannelType {
  TEXT
  ANNOUNCEMENT
}

enum SubmissionStatus {
  PENDING
  GRADED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum RewardStatus {
  PENDING
  CLAIMED
}

model User {
  id             Int       @id @default(autoincrement())
  username       String    @unique
  password_hash  String
  role           Role      @default(STUDENT)
  name           String
  student_number String?
  total_points   Int       @default(0)
  last_active      DateTime?
  character_data   Json?
  line_user_id     String?

  // Relations
  assignments    Assignment[]
  submissions    Submission[]
  transactions         Treasury[]  @relation("TreasuryStudent")
  created_transactions Treasury[]  @relation("TreasuryCreator")
  approved_transactions Treasury[] @relation("TreasuryApprover")
  quiz_attempts  QuizAttempt[]
  quizzes_created  Quiz[]       @relation("QuizCreator")
  channels_created Channel[]   @relation("ChannelCreator")
  messages         Message[]   @relation("MessageAuthor")
  deleted_messages Message[]   @relation("MessageDeleter")
  reward_logs    RewardLog[]
  events         Event[]
  daily_homework        DailyHomework[]
  homework_submissions  HomeworkSubmission[]
  homework_reads        HomeworkRead[]
  subjects              Subject[]       @relation("SubjectTeacher")
  assignment_comments AssignmentComment[]
  vocab_words    VocabWord[]     @relation("VocabCreator")
  challenged     VocabBattle[]   @relation("BattleChallenger")
  opponent_in    VocabBattle[]   @relation("BattleOpponent")
  won_battles    VocabBattle[]   @relation("BattleWinner")
  battle_stats   BattleStats?
  pet_words      PetWord[]
  pet_state      PetState?
  python_state   PythonState?
  activity_logs  ActivityLog[]
  practice_items    PracticeItem[]    @relation("PracticeItemAuthor")
  practice_attempts PracticeAttempt[]
  mastery_states    MasteryState[]
}

/* ═══════════ ระบบวิเคราะห์การเรียนรู้ (Learning Analytics) ═══════════ */

// คลังข้อสอบที่ผูกกับ วิชา → หัวข้อ → หัวข้อย่อย + ระดับ Bloom
model PracticeItem {
  id             Int      @id @default(autoincrement())
  subject_id     Int
  topic          String                        // หัวข้อหลัก
  sub_topic      String                        // หัวข้อย่อย — หน่วยที่ใช้วัด mastery
  bloom          String   @default("understand") // remember|understand|apply|analyze|evaluate|create
  question_text  String
  choices        Json                          // ["ก","ข","ค","ง"]
  correct_answer String
  explanation    String?                       // เฉลยอธิบาย แสดงหลังตอบ
  hint           String?
  misconception  Json?                          // { "ตัวเลือกที่ผิด": "มโนทัศน์ที่คลาดเคลื่อน" }
  elo            Float    @default(1200)       // ความยากแบบไดนามิก
  times_shown    Int      @default(0)
  times_correct  Int      @default(0)
  is_active      Boolean  @default(true)
  created_by     Int?
  created_at     DateTime @default(now())
  source_question_id Int? @unique   // ผูกกับ Question ของ Quiz เดิม → ให้ Quiz ป้อนสถิติเข้าระบบวิเคราะห์ได้

  subject        Subject  @relation(fields: [subject_id], references: [id])
  author         User?    @relation("PracticeItemAuthor", fields: [created_by], references: [id])
  attempts       PracticeAttempt[]

  @@index([subject_id, topic, sub_topic])
  @@index([is_active])
}

// ประวัติการตอบรายข้อ (time-series) — ข้อมูลดิบสำหรับวิเคราะห์
model PracticeAttempt {
  id             Int      @id @default(autoincrement())
  user_id        Int
  item_id        Int
  subject_id     Int
  topic          String
  sub_topic      String
  bloom          String
  is_correct     Boolean
  chosen_answer  String?
  time_spent_sec Int      @default(0)
  answer_changes Int      @default(0)   // เปลี่ยนคำตอบกี่ครั้งก่อนส่ง
  hint_used      Boolean  @default(false)
  skipped        Boolean  @default(false)
  source         String   @default("practice")  // practice | quiz — quiz ไม่มีเวลารายข้อจริง
  quality        Int      @default(0)   // q 0–5 สำหรับ SM-2
  attempt_number Int      @default(1)   // ทำข้อนี้เป็นครั้งที่เท่าไร
  elo_before     Float    @default(1200)
  elo_after      Float    @default(1200)
  item_elo_before Float   @default(1200)
  created_at     DateTime @default(now())

  user           User         @relation(fields: [user_id], references: [id])
  item           PracticeItem @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([user_id, sub_topic])
  @@index([item_id])
  @@index([subject_id])
}

// สถานะความรู้ปัจจุบันของผู้เรียน ต่อ 1 หัวข้อย่อย (snapshot)
model MasteryState {
  id               Int      @id @default(autoincrement())
  user_id          Int
  subject_id       Int
  topic            String
  sub_topic        String

  elo              Float    @default(1200)   // ความสามารถ (Elo)
  p_known          Float    @default(0.15)   // BKT: โอกาสที่เข้าใจแล้วจริง
  mastery_status   String   @default("new")  // new|learning|developing|proficient|mastered
  streak           Int      @default(0)      // ตอบถูกติดกัน
  longest_streak   Int      @default(0)
  total_attempts   Int      @default(0)
  total_correct    Int      @default(0)
  avg_time_sec     Float    @default(0)
  first_accuracy   Float?                    // % ถูกช่วง 5 ครั้งแรก — ใช้เทียบ growth
  recent_accuracy  Float?                    // % ถูกช่วง 5 ครั้งล่าสุด

  // SM-2 spaced repetition
  ef               Float    @default(2.5)
  interval_days    Int      @default(0)
  reps             Int      @default(0)
  next_review_date DateTime?
  last_tested_at   DateTime?
  updated_at       DateTime @updatedAt

  user             User     @relation(fields: [user_id], references: [id])

  @@unique([user_id, sub_topic])
  @@index([user_id, next_review_date])
  @@index([subject_id])
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  user_id    Int?                        // null = ยังไม่ล็อกอิน (เช่น login ล้มเหลว)
  username   String?                     // เก็บซ้ำไว้ เผื่อผู้ใช้ถูกลบภายหลัง
  name       String?
  role       String?
  action     String                      // ป้ายกำกับภาษาไทย เช่น "เข้าสู่ระบบ"
  category   String                      // auth | users | quiz | ... สำหรับกรอง
  method     String
  path       String
  status     Int
  detail     String?                     // ข้อมูลย่อ เช่น ชื่อรายการที่แก้
  ip         String?
  user_agent String?
  created_at DateTime @default(now())

  user       User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([created_at])
  @@index([user_id])
  @@index([category])
}

model Setting {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  value      String
  updated_at DateTime @updatedAt
}

model Subject {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  teacher_id  Int?
  created_at  DateTime     @default(now())

  teacher     User?        @relation("SubjectTeacher", fields: [teacher_id], references: [id])
  assignments Assignment[]
  practice_items PracticeItem[]
}

model Assignment {
  id              Int       @id @default(autoincrement())
  title           String
  description     String?
  start_date      DateTime?
  due_date        DateTime
  max_score       Int
  bonus_points    Int       @default(0)
  homework_type   String?
  submit_location String?
  created_by      Int
  subject_id      Int?

  // Relations
  teacher     User      @relation(fields: [created_by], references: [id])
  subject     Subject?  @relation(fields: [subject_id], references: [id])
  submissions Submission[]
  comments    AssignmentComment[]
}

model AssignmentComment {
  id            Int      @id @default(autoincrement())
  assignment_id Int
  user_id       Int
  content       String
  created_at    DateTime @default(now())

  assignment    Assignment @relation(fields: [assignment_id], references: [id])
  user          User       @relation(fields: [user_id], references: [id])
}

model Submission {
  id            Int              @id @default(autoincrement())
  assignment_id Int
  student_id    Int
  file_url      String?
  submitted_at  DateTime         @default(now())
  status        SubmissionStatus @default(PENDING)
  score_given   Int?
  
  // Relations
  assignment    Assignment       @relation(fields: [assignment_id], references: [id])
  student       User             @relation(fields: [student_id], references: [id])
}

model Treasury {
  id          Int             @id @default(autoincrement())
  student_id  Int?
  amount      Float
  type        TransactionType
  description String?
  created_at  DateTime        @default(now())
  tx_status   TreasuryStatus  @default(APPROVED)
  created_by  Int?
  approved_by Int?

  // Relations
  student     User?           @relation("TreasuryStudent",   fields: [student_id], references: [id])
  creator     User?           @relation("TreasuryCreator",   fields: [created_by],  references: [id])
  approver    User?           @relation("TreasuryApprover",  fields: [approved_by], references: [id])
}

model Quiz {
  id           Int           @id @default(autoincrement())
  title        String
  description  String?
  time_limit   Int           @default(600)  // seconds, 0 = no limit
  max_attempts Int           @default(1)    // 0 = unlimited
  points_per_q Int           @default(10)   // points per correct answer
  created_by   Int
  created_at   DateTime      @default(now())
  is_active    Boolean       @default(true)

  // Relations
  creator      User          @relation("QuizCreator", fields: [created_by], references: [id])
  questions    Question[]
  attempts     QuizAttempt[]
}

model Question {
  id             Int    @id @default(autoincrement())
  quiz_id        Int
  question_text  String
  choices        Json
  correct_answer String
  
  // Relations
  quiz           Quiz   @relation(fields: [quiz_id], references: [id])
}

model QuizAttempt {
  id           Int      @id @default(autoincrement())
  student_id   Int
  quiz_id      Int
  score        Int
  total_q      Int      @default(0)
  correct      Int      @default(0)
  time_taken   Int      @default(0)  // seconds
  answers      Json?    // { question_id: chosen_answer }
  completed_at DateTime @default(now())

  // Relations
  student      User     @relation(fields: [student_id], references: [id])
  quiz         Quiz     @relation(fields: [quiz_id], references: [id])
}

model Reward {
  id              Int         @id @default(autoincrement())
  title           String
  image_url       String?
  points_required Int
  stock           Int         @default(0)
  
  // Relations
  reward_logs     RewardLog[]
}

model RewardLog {
  id          Int          @id @default(autoincrement())
  student_id  Int
  reward_id   Int
  status      RewardStatus @default(PENDING)
  redeemed_at DateTime     @default(now())

  // Relations
  student     User         @relation(fields: [student_id], references: [id])
  reward      Reward       @relation(fields: [reward_id], references: [id])
}

model DailyHomework {
  id              Int      @id @default(autoincrement())
  student_id      Int
  subject         String
  detail          String?
  homework_type   String   @default("อื่นๆ")
  due_date        DateTime? @db.Date
  submit_location String   @default("ในห้องเรียน")
  date            DateTime @db.Date
  done            Boolean  @default(false)
  created_at      DateTime @default(now())

  // Relations
  student     User                  @relation(fields: [student_id], references: [id])
  submissions HomeworkSubmission[]
  reads       HomeworkRead[]
}

model HomeworkSubmission {
  id           Int          @id @default(autoincrement())
  homework_id  Int
  student_id   Int
  submitted_at DateTime     // วันเวลาที่นักเรียนระบุว่าส่ง
  status       SubmitStatus @default(SUBMITTED)
  note         String?
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt

  homework     DailyHomework @relation(fields: [homework_id], references: [id])
  student      User          @relation(fields: [student_id], references: [id])

  @@unique([homework_id, student_id])
}

model HomeworkRead {
  id          Int           @id @default(autoincrement())
  homework_id Int
  student_id  Int
  viewed_at   DateTime      @default(now())

  homework    DailyHomework @relation(fields: [homework_id], references: [id])
  student     User          @relation(fields: [student_id], references: [id])

  @@unique([homework_id, student_id])
}

enum SubmitStatus {
  SUBMITTED
  APPROVED
  LATE
  REJECTED
}

model Event {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  start_date  DateTime
  end_date    DateTime?
  color       String    @default("#7c3aed")
  event_type  EventType @default(EVENT)
  created_by  Int?
  created_at  DateTime  @default(now())
  is_all_day  Boolean   @default(false)
  is_personal Boolean   @default(false)  // NOTE type: only creator sees it

  // Relations
  creator     User?     @relation(fields: [created_by], references: [id])
}

model Channel {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  description String?
  type        ChannelType @default(TEXT)
  created_by  Int
  created_at  DateTime    @default(now())
  is_active   Boolean     @default(true)
  position    Int         @default(0)

  creator     User        @relation("ChannelCreator", fields: [created_by], references: [id])
  messages    Message[]
}

model Message {
  id         Int      @id @default(autoincrement())
  channel_id Int
  user_id    Int
  content    String
  created_at DateTime @default(now())
  edited_at  DateTime?
  deleted    Boolean  @default(false)
  deleted_by Int?

  channel    Channel  @relation(fields: [channel_id], references: [id])
  user       User     @relation("MessageAuthor",  fields: [user_id],    references: [id])
  deleter    User?    @relation("MessageDeleter", fields: [deleted_by], references: [id])
}

// ══════════════════════════════════════════
// VOCAB BATTLE GAME
// ══════════════════════════════════════════

enum EventType {
  EVENT
  HOLIDAY
  SCHOOL
  NOTE
}

enum BattleStatus {
  PENDING
  ACTIVE
  FINISHED
  DECLINED
}

model VocabWord {
  id          Int      @id @default(autoincrement())
  word        String
  translation String
  hint        String?
  category    String   @default("ทั่วไป")
  created_by  Int
  created_at  DateTime @default(now())

  creator     User     @relation("VocabCreator", fields: [created_by], references: [id])
}

model VocabBattle {
  id            Int          @id @default(autoincrement())
  challenger_id Int
  opponent_id   Int
  status        BattleStatus @default(PENDING)
  winner_id     Int?
  challenger_hp Int          @default(100)
  opponent_hp   Int          @default(100)
  challenger_wins Int        @default(0)
  opponent_wins   Int        @default(0)
  rounds_played   Int        @default(0)
  max_rounds      Int        @default(15)
  category        String?
  created_at    DateTime     @default(now())
  finished_at   DateTime?

  challenger    User  @relation("BattleChallenger", fields: [challenger_id], references: [id])
  opponent      User  @relation("BattleOpponent",   fields: [opponent_id],   references: [id])
  winner        User? @relation("BattleWinner",     fields: [winner_id],     references: [id])
}

model BattleStats {
  id          Int  @id @default(autoincrement())
  user_id     Int  @unique
  wins        Int  @default(0)
  losses      Int  @default(0)
  total_combo Int  @default(0)
  best_combo  Int  @default(0)

  user        User @relation(fields: [user_id], references: [id])
}

model PetWord {
  id       Int      @id @default(autoincrement())
  word     String   @unique
  used_by  Int
  used_at  DateTime @default(now())

  user     User     @relation(fields: [used_by], references: [id])
}

model PythonState {
  id          Int      @id @default(autoincrement())
  user_id     Int      @unique
  score       Int      @default(0)            // คะแนนรวมจากเมนู Python
  best_score  Int      @default(0)
  xp          Int      @default(0)
  level       Int      @default(1)
  hints       Int      @default(5)            // สิทธิ์ดูคำใบ้ที่เหลือ
  char_name   String   @default("PyBot")
  learned     Json?                           // { print:true, ... }
  missions    Json?                           // { m1:true, ... }
  rewards     Json?                           // { r1:true, ... }
  exercises   Json?                           // { ex1:true, ... }
  history     Json?                           // [{ pts, reason, time }] เก็บ 30 รายการล่าสุด
  ran_input   Boolean  @default(false)
  updated_at  DateTime @updatedAt

  user        User     @relation(fields: [user_id], references: [id])
}

model PetState {
  id          Int      @id @default(autoincrement())
  user_id     Int      @unique
  hunger      Float    @default(60)
  pet_name    String   @default("น้องฟัฟฟี่")
  pet_type    String   @default("CAT")
  xp          Int      @default(0)
  stage       String   @default("EGG")
  total_words Int      @default(0)
  health      String   @default("healthy")   // healthy | sick | injured
  item_herb   Int      @default(1)           // ยาสมุนไพรเวท
  item_kit    Int      @default(1)           // ชุดรักษาเวท
  rest_until  DateTime?                      // พักฟื้นถึงเมื่อไร

  element     String   @default("")          // FIRE | WATER | GRASS | LIGHT | DARK (เลือกครั้งเดียว)
  atk_lv      Int      @default(1)           // ระดับทักษะการโจมตี
  atk_xp      Int      @default(0)           // EXP ทักษะโจมตีในเลเวลปัจจุบัน
  def_lv      Int      @default(1)           // ระดับทักษะป้องกัน (ฝึกด้วยโจทย์การหาร)
  def_xp      Int      @default(0)
  eva_lv      Int      @default(1)           // ระดับทักษะหลบหลีก (ฝึกด้วยโจทย์สมการ)
  eva_xp      Int      @default(0)
  stamina     Int      @default(5)           // พลังฝึกซ้อม (ฟื้นเองตามเวลา)
  stamina_at  DateTime?                      // เวลาที่คิด stamina ล่าสุด
  pvp_wins    Int      @default(0)
  pvp_losses  Int      @default(0)

  item_snack  Int      @default(0)           // ขนมพิเศษ (+EXP เมื่อใช้)
  costume     String   @default("")          // ชุดที่ใส่อยู่ ('' = ไม่ใส่)
  wardrobe    Json?                          // array ของ costume key ที่สะสมได้

  last_sick_at DateTime?                     // ครั้งล่าสุดที่ป่วย — ใช้จับรอบป่วยทุก 2 วัน

  updated_at  DateTime @updatedAt

  user        User     @relation(fields: [user_id], references: [id])
}

// ══════════════════════════════════════════
// BINGO ONLINE
// ══════════════════════════════════════════

model BingoRoom {
  id            String    @id @default(uuid())
  name          String
  created_by    Int
  status        String    @default("waiting") // waiting | playing | finished
  current_round Int       @default(0)
  total_rounds  Int       @default(3)
  drawn_numbers Int[]     @default([])
  ticket_price  Float     @default(0)          // ราคาบัตรต่อใบ (บาท)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  rounds        BingoRound[]
  cards         BingoCard[]
  prize_inventory BingoPrizeInventory[] @relation("PrizeInventoryOwner")
}

model BingoRound {
  id            Int       @id @default(autoincrement())
  room_id       String
  round_number  Int
  pattern       String    @default("line")    // line | full | corners | T | L
  prize         String?
  prize_image   String?                       // optional URL for prize image
  prize_value   Float     @default(0)         // มูลค่าของรางวัล (บาท)
  is_golden     Boolean   @default(false)
  drawn_numbers Int[]     @default([])
  status        String    @default("pending") // pending | active | finished
  started_at    DateTime?
  ended_at      DateTime?

  prize_inventory_id  Int?
  prize_inventory     BingoPrizeInventory? @relation(fields: [prize_inventory_id], references: [id])

  room          BingoRoom @relation(fields: [room_id], references: [id], onDelete: Cascade)
  winners       BingoWinner[]
  cards         BingoCard[] @relation("RoundCards")
}

model BingoCard {
  id            Int       @id @default(autoincrement())
  room_id       String
  alias         String
  numbers       Int[]                         // 25 numbers for 5x5 grid
  round_id      Int?                          // null = room-level (legacy); set = round-specific card
  created_at    DateTime  @default(now())

  room          BingoRoom  @relation(fields: [room_id], references: [id], onDelete: Cascade)
  round         BingoRound? @relation("RoundCards", fields: [round_id], references: [id])
  wins          BingoWinner[]
}

model BingoPrizeInventory {
  id         Int          @id @default(autoincrement())
  name       String
  value      Float        @default(0)
  quantity   Int          @default(0)
  remaining  Int          @default(0)
  owner_id   Int
  owner      User         @relation("PrizeInventoryOwner", fields: [owner_id], references: [id])
  rounds     BingoRound[]
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
}

model BingoWinner {
  id            Int         @id @default(autoincrement())
  round_id      Int
  card_id       Int
  alias         String
  won_at        DateTime    @default(now())

  round         BingoRound  @relation(fields: [round_id], references: [id], onDelete: Cascade)
  card          BingoCard   @relation(fields: [card_id], references: [id], onDelete: Cascade)
}
